{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');fs.writeFileSync('dist/_routes.json',JSON.stringify({version:1,include:['/*'],exclude:['/static/*','/favicon.ico','/apple-touch-icon.png','/icon-192.png']}))\"",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.6"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "sharp": "^0.34.5",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
